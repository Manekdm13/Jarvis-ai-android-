{
  "name": "JARVIS Android + Cloudflare Worker",
  "image": "mcr.microsoft.com/devcontainers/java:0-17",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-android.sh",
  "forwardPorts": [
    8787
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "redhat.java"
      ]
    }
  }
}
